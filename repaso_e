numero = int(input("Ingresa un número del 1 al 7: "))


if numero == 1:
    print("El día es Lunes.")
elif numero == 2:
    print("El día es Martes.")
elif numero == 3:
    print("El día es Miércoles.")
elif numero == 4:
    print("El día es Jueves.")
elif numero == 5:
    print("El día es Viernes.")
elif numero == 6:
    print("El día es Sábado.")
elif numero == 7:
    print("El día es Domingo.")
else:

    print("Error: El número ingresado no es válido. Debe ser del 1 al 7.")
